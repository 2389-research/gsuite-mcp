# Google OAuth Credentials
# Download from Google Cloud Console > APIs & Services > Credentials
GSUITE_MCP_CREDENTIALS_PATH=credentials.json
GSUITE_MCP_TOKEN_PATH=token.json

# Ish Mode (Testing)
# Set ISH_MODE=true to enable fake authentication for testing
#ISH_MODE=true
ISH_BASE_URL=http://localhost:9000
ISH_USER=testuser@example.com
